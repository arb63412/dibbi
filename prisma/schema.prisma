generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Admin (single shop owner) ───────────────────────────────────────────────

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Customer ────────────────────────────────────────────────────────────────

model Customer {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String?
  phone        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  orders       Order[]
  wishlist     WishlistItem[]
  threads      MessageThread[]
  messages     Message[]
}

// ─── Listings ────────────────────────────────────────────────────────────────

enum Condition {
  MINT
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}

model Listing {
  id             String        @id @default(cuid())
  title          String
  description    String
  slug           String        @unique
  price          Int?          // Price in cents (AUD), GST-inclusive. Null if priceOnRequest.
  priceOnRequest Boolean       @default(false)
  condition      Condition
  era            String?
  materials      String[]
  dimensions     String?
  weight         String?
  provenance     String?
  status         ListingStatus @default(DRAFT)
  featured       Boolean       @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  images        ListingImage[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  threads       MessageThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([featured])
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  position  Int     @default(0)
  width     Int?
  height    Int?

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Orders ──────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique @default(cuid())
  customerId           String?
  customer             Customer?   @relation(fields: [customerId], references: [id])
  customerEmail        String
  customerName         String
  items                OrderItem[]
  status               OrderStatus @default(PENDING)
  subtotal             Int         // cents AUD (ex-GST)
  gstAmount            Int         // cents AUD
  shippingCost         Int         // cents AUD
  totalAmount          Int         // cents AUD (subtotal + gst + shipping)
  shippingAddress      Json
  trackingNumber       String?
  trackingUrl          String?
  stripePaymentIntentId String?
  notes                String?     // Admin notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  title     String  // Snapshot at time of purchase
  price     Int     // Snapshot in cents AUD
  quantity  Int     @default(1)

  @@index([orderId])
}

// ─── Wishlist ────────────────────────────────────────────────────────────────

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, listingId])
}

// ─── Messaging ───────────────────────────────────────────────────────────────

enum ThreadStatus {
  OPEN
  CLOSED
}

enum SenderRole {
  CUSTOMER
  ADMIN
}

model MessageThread {
  id            String       @id @default(cuid())
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  customerEmail String
  subject       String
  listingId     String?
  listing       Listing?     @relation(fields: [listingId], references: [id])
  status        ThreadStatus @default(OPEN)
  messages      Message[]
  lastMessageAt DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([customerId])
  @@index([status])
}

model Message {
  id         String      @id @default(cuid())
  threadId   String
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  senderRole SenderRole
  body       String
  read       Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([threadId])
}

// ─── Site Settings (singleton) ───────────────────────────────────────────────

enum ShippingProvider {
  FLAT_RATE
}

model SiteSettings {
  id               String           @id @default("default")
  shopName         String           @default("Dibbi")
  shopDescription  String?
  logo             String?
  aboutContent     String?
  contactEmail     String?
  phone            String?
  socialLinks      Json?
  shippingRate     Int              @default(1500) // cents AUD (default $15)
  shippingProvider ShippingProvider @default(FLAT_RATE)
  gstRate          Float            @default(0.10) // 10%
  abnNumber        String?
  updatedAt        DateTime         @updatedAt
}
